# ---- Dependencies (never commit; `npm install` recreates them) ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output ----
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ---- Generated at install/build time ----
web/public/vendor/

# ---- Secrets: keep keys out of Git ----
.env
.env.*
!.env.example
*.pem

# ---- Hosting / tooling ----
.vercel/
supabase/.temp/
supabase/.branches/

# ---- Tests and logs ----
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Local scratch ----
Claude outputs/
