NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Design preview with fictional sample data at /preview/history, /preview/vehicle, /preview/vehicles.
# Local review only - never set this in production.
# ENABLE_DESIGN_PREVIEW=1

# Route planning (OpenStreetMap services by default; point these at your own servers for production).
# GEOCODER_URL=https://nominatim.openstreetmap.org
# ROUTING_URL=https://router.project-osrm.org
# OSM_USER_AGENT="EVChargePress/0.1 (you@example.com)"

# Connected cars (Smartcar Vehicles API v3). Server-only — never prefix with NEXT_PUBLIC_.
# SMARTCAR_CLIENT_ID=        # dashboard.smartcar.com → your app → Client ID (also used as application_id in Connect)
# SMARTCAR_CLIENT_SECRET=
# SMARTCAR_MODE=simulated    # "simulated" = Smartcar test vehicles; "live" = real cars
# SMARTCAR_REDIRECT_URI=     # optional; defaults to <site>/api/vehicle-connect/smartcar/callback
# VEHICLE_INGEST_KEY=        # random secret; its hash is stored with app.set_integration_key('vehicle_ingest', ...)

# Admin panel: adding users and changing a user's email or password (Supabase Auth admin API).
# Supabase dashboard → Project Settings → API Keys → secret / service_role key.
# Server-only — never prefix with NEXT_PUBLIC_, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=
